{
  "name": "online-money-transfer-rates",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "if [ \"$RENDER\" = \"true\" ]; then npm run render:build; else bash scripts/build-verified.sh; fi",
    "start": "if [ \"$RENDER\" = \"true\" ]; then npm run render:start; else WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start; fi",
    "render:build": "next build --webpack",
    "render:start": "npm run db:migrate:render && next start -H 0.0.0.0 -p ${PORT:-3000}",
    "db:migrate:render": "node scripts/migrate-postgres.mjs",
    "test:render-schema": "node --test tests/render-postgres.test.mjs",
    "test": "npm run build && node --experimental-loader ./scripts/cloudflare-node-loader.mjs --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .sites-runtime --ignore-pattern .pw-browsers --ignore-pattern crawler/node_modules",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "pg-mem": "^3.0.14",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Online Money Transfer"
}
